{
  "name": "isb",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "node scripts/serve-dist.mjs",
    "astro": "astro",
    "check": "astro check",
    "typecheck": "astro check",
    "lint": "eslint .",
    "test": "node --test tests/unit/*.test.mjs",
    "validate:content": "node scripts/validate-content.mjs",
    "format": "prettier --check .",
    "verify:fast": "npm run lint && npm run check && npm run validate:content",
    "verify:feature": "npm run verify:fast && npm run build && npm run test:e2e",
    "test:e2e": "playwright test",
    "extract-content": "node ./scripts/extract-docx.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/tailwind": "^6.0.2",
    "@fontsource/vazirmatn": "^5.3.0",
    "astro": "^5.18.2",
    "fast-xml-parser": "^5.11.2",
    "jszip": "^3.10.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@playwright/test": "^1.64.1",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.56.1",
    "astro-eslint-parser": "^1.4.0",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.39.5",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "postcss": "^8.5.31",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3"
  }
}
