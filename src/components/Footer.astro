---
import { Image } from "astro:assets";
import contactsData from "../content/contacts.json";
import servicesData from "../content/services.json";
import { logoImageOptions, resolveRaster } from "../lib/media";
import { toPersianDigits } from "../lib/locale";
import type { ContactsContent, ServiceItem } from "../lib/types";

const logo = resolveRaster("/images/brand/isbatab-logo.png");

const contacts = contactsData as ContactsContent;
const yearFa = toPersianDigits(new Date().getFullYear());
const mapOffice =
  contacts.addresses.find((address) => address.city.includes("تهران")) ?? contacts.addresses[0];
// A short contextual list of major services with dedicated pages.
const services = (servicesData as ServiceItem[]).filter((service) => service.detailPage).slice(0, 5);
---

<footer class="border-t border-brand-border bg-brand-primary py-10 text-slate-100">
  <div class="container-wrap grid gap-8 md:grid-cols-2 xl:grid-cols-5">
    <div>
      {
        logo ? (
          <Image
            src={logo}
            {...logoImageOptions}
            loading="lazy"
            decoding="async"
            alt="لوگوی ایمن صنعت باتاب"
            class="h-11 w-auto"
          />
        ) : (
          <img
            src="/images/brand/isbatab-logo.png"
            alt="لوگوی ایمن صنعت باتاب"
            width="924"
            height="282"
            loading="lazy"
            decoding="async"
            class="h-11 w-auto"
          />
        )
      }
      <p class="mt-2 text-sm leading-7 text-slate-300">
        مشاوره، آموزش، خدمات ایمنی و بازرسی فنی برای صنایع نفت، گاز، پتروشیمی و پروژه‌های عمرانی.
      </p>
    </div>
    <div>
      <p class="font-semibold text-white">راه‌های ارتباطی</p>
      <ul class="mt-3 space-y-2 text-sm text-slate-300">
        {
          contacts.phones.map((phone) => (
            <li>
              <a href={`tel:${phone.tel}`} class="hover:text-white">
                {phone.label}: <span class="num-text">{toPersianDigits(phone.number)}</span>
              </a>
            </li>
          ))
        }
        <li>
          <a href={`mailto:${contacts.email}`} class="latin-text hover:text-white">
            {contacts.email}
          </a>
        </li>
      </ul>
    </div>
    <div>
      <p class="font-semibold text-white">آدرس دفتر</p>
      <ul class="mt-3 space-y-3 text-sm leading-7 text-slate-300">
        {
          contacts.addresses.map((address) => (
            <li>
              <p class="font-semibold text-slate-200">{address.city}</p>
              <p>{address.fullAddress}</p>
            </li>
          ))
        }
      </ul>
    </div>
    {
      mapOffice?.embedUrl && (
        <div>
          <p class="font-semibold text-white">نقشه دفتر تهران</p>
          <iframe
            title="نقشه کوچک دفتر تهران ایمن صنعت باتاب"
            src={mapOffice.embedUrl}
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            class="mt-3 h-36 w-full rounded-xl border border-slate-700"
          ></iframe>
          <a
            href={mapOffice.mapUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-2 inline-flex text-xs font-semibold text-slate-300 hover:text-white"
          >
            مشاهده بزرگ روی نقشه
          </a>
        </div>
      )
    }
    <div>
      <p class="font-semibold text-white">دسترسی سریع</p>
      <ul class="mt-3 space-y-2 text-sm text-slate-300">
        <li><a href="/about/" class="hover:text-white">درباره شرکت</a></li>
        <li><a href="/services/" class="hover:text-white">خدمات</a></li>
        <li><a href="/certifications/" class="hover:text-white">گواهی‌نامه‌ها و مجوزها</a></li>
        <li><a href="/projects/" class="hover:text-white">پروژه‌ها</a></li>
        <li><a href="/contact/" class="hover:text-white">تماس با ما</a></li>
      </ul>
      <p class="mt-5 font-semibold text-white">خدمات تخصصی</p>
      <ul class="mt-3 space-y-2 text-sm text-slate-300">
        {
          services.map((service) => (
            <li>
              <a href={`/services/${service.id}/`} class="hover:text-white">
                {service.title}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
  <div class="container-wrap mt-8 border-t border-slate-700 pt-5 text-xs text-slate-400">
    © {yearFa} ایمن صنعت باتاب - تمامی حقوق محفوظ است.
  </div>
</footer>
