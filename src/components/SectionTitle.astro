---
interface Props {
  title: string;
  subtitle?: string;
  centered?: boolean;
  /** Heading level: h1 for the single primary page heading, h2 for sections. */
  level?: "h1" | "h2" | "h3";
}

const { title, subtitle, centered = false, level = "h2" } = Astro.props as Props;
---

<div class:list={["mb-8", centered && "text-center"]}>
  {
    level === "h1" ? (
      <h1 class="text-2xl font-bold text-brand-primary sm:text-3xl">{title}</h1>
    ) : level === "h3" ? (
      <h3 class="text-2xl font-bold text-brand-primary sm:text-3xl">{title}</h3>
    ) : (
      <h2 class="text-2xl font-bold text-brand-primary sm:text-3xl">{title}</h2>
    )
  }
  {
    subtitle && (
      <p class="mt-3 max-w-3xl text-sm leading-7 text-brand-muted sm:text-base">{subtitle}</p>
    )
  }
</div>
