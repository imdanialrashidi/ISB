---
import { toPersianDigits } from "../lib/locale";
import type { ProjectItem } from "../lib/types";

interface Props {
  project: ProjectItem;
  index: number;
}

const { project, index } = Astro.props as Props;
const row = toPersianDigits(index + 1);
---

<article class="card hover-lift group h-full p-5">
  <div class="flex items-start gap-3">
    <span
      class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-brand-accent/10 text-sm font-bold text-brand-accent"
      aria-hidden="true"
    >
      {row}
    </span>
    <div>
      <h3 class="text-base font-bold leading-7 text-brand-primary">{project.title}</h3>
      <p class="mt-1 text-sm text-brand-muted">{project.client}</p>
    </div>
  </div>
</article>
