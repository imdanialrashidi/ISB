---
import { Image } from "astro:assets";
import { cardImageOptions, resolveRaster } from "../lib/media";
import type { ServiceItem } from "../lib/types";

interface Props {
  service: ServiceItem;
}

const { service } = Astro.props as Props;
const imageSrc = service.image || "/images/placeholders/service-safety.svg";
const raster = resolveRaster(service.image);
const imageClass =
  "h-36 w-full object-cover transition duration-500 group-hover:scale-105";
---

<article class="card hover-lift group h-full overflow-hidden">
  <div class="relative overflow-hidden">
    {
      raster ? (
        <Image
          src={raster}
          {...cardImageOptions}
          loading="lazy"
          decoding="async"
          alt={service.title}
          class={imageClass}
        />
      ) : (
        <img
          src={imageSrc}
          width="640"
          height="360"
          loading="lazy"
          decoding="async"
          alt={service.title}
          class={imageClass}
        />
      )
    }
    <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-brand-primary/25 to-transparent"></div>
  </div>
  <div class="p-5">
    <p class="text-xs font-semibold text-brand-accent">{service.category}</p>
    {
      service.detailPage ? (
        <h3 class="mt-2 text-base font-bold">
          <a
            href={`/services/${service.id}/`}
            class="text-brand-primary transition hover:text-brand-accent focus-visible:text-brand-accent"
          >
            {service.title}
          </a>
        </h3>
      ) : (
        <h3 class="mt-2 text-base font-bold text-brand-primary">{service.title}</h3>
      )
    }
    <p class="mt-3 text-sm leading-7 text-brand-muted">{service.summary}</p>
    {
      service.details.length > 0 && (
        <ul class="mt-4 space-y-1 text-sm text-brand-text">
          {service.details.map((item) => <li>• {item}</li>)}
        </ul>
      )
    }
    {
      service.highlights.length > 0 && (
        <ul class="mt-4 flex flex-wrap gap-2">
          {service.highlights.map((item) => (
            <li class="rounded-full border border-brand-accent/30 bg-brand-accent/5 px-3 py-1 text-xs font-semibold text-brand-accent">
              {item}
            </li>
          ))}
        </ul>
      )
    }
  </div>
</article>
