---
import { Image } from "astro:assets";
import { resolveRaster } from "../lib/media";
import type { CompanyContent } from "../lib/types";

interface Props {
  company: CompanyContent;
}

const { company } = Astro.props as Props;
const orgChart = resolveRaster("/images/company/org-chart.png");
---

<section class="card p-6">
  <h2 class="text-xl font-bold text-brand-primary">چارت سازمانی</h2>
  <p class="mt-3 text-sm leading-7 text-brand-muted">{company.organizationalStructure}</p>

  <figure class="mt-6 overflow-hidden rounded-xl border border-brand-border bg-white">
    {
      orgChart ? (
        <Image
          src={orgChart}
          widths={[640, 960, 1280, 1600]}
          sizes="(min-width: 768px) 1036px, 100vw"
          width={1600}
          height={588}
          format="webp"
          quality={94}
          loading="eager"
          decoding="async"
          alt="چارت سازمانی شرکت ایمن صنعت باتاب شامل مدیرعامل، معاونت‌های اداری و فنی و واحدهای تخصصی بازرسی فنی، ایمنی و آتش‌نشانی، آموزش، قراردادها و مالی-اداری"
          class="aspect-[1600/588] h-auto w-full bg-white"
          style="object-position: center top"
        />
      ) : (
        <img
          src="/images/company/org-chart.png"
          alt="چارت سازمانی شرکت ایمن صنعت باتاب شامل مدیرعامل، معاونت‌های اداری و فنی و واحدهای تخصصی بازرسی فنی، ایمنی و آتش‌نشانی، آموزش، قراردادها و مالی-اداری"
          width="1600"
          height="588"
          loading="eager"
          decoding="async"
          class="aspect-[1600/588] h-auto w-full bg-white"
          style="object-position: center top"
        />
      )
    }
    <figcaption class="border-t border-brand-border bg-slate-50 px-4 py-3 text-xs text-brand-muted">
      چارت سازمانی شرکت ایمن صنعت باتاب
    </figcaption>
  </figure>

  <div class="mt-6 rounded-xl border border-brand-border bg-white p-4">
    <p class="text-xs text-brand-muted">مدیریت ارشد</p>
    <p class="mt-1 font-bold text-brand-primary">
      {company.organizationalChart.ceo}{' '}
      <a
        href="/about/ceo-resume/"
        class="mr-2 inline-flex items-center rounded-full border border-brand-accent/20 bg-brand-accent/5 px-3 py-1 text-xs font-semibold text-brand-accent transition hover:bg-brand-accent hover:text-white"
        aria-label="رزومه مدیرعامل"
      >
        رزومه
      </a>
    </p>
    <p class="mt-2 text-xs leading-6 text-brand-muted">
      رزومه تفصیلی مدیرعامل به‌زودی در این بخش منتشر خواهد شد.
    </p>
  </div>
</section>
