---
import Badge from "../components/Badge.astro";
import OrganizationChart from "../components/OrganizationChart.astro";
import companyData from "../content/company.json";
import BaseLayout from "../layouts/BaseLayout.astro";
import { toPersianDigits } from "../lib/locale";
import type { CompanyContent } from "../lib/types";

const company = companyData as CompanyContent;
---

<BaseLayout
  title="درباره شرکت ایمن صنعت باتاب"
  description="معرفی شرکت ایمن صنعت باتاب، بیانیه ماموریت، چشم‌انداز، ارزش‌ها، خط مشی کامل، ساختار سازمانی و مجوزها."
  canonicalPath="/about"
>
  <section class="section-block">
    <div class="container-wrap">
      <h1 class="text-2xl font-bold text-brand-primary sm:text-3xl">
        درباره شرکت ایمن صنعت باتاب
      </h1>
      <p class="mt-4 max-w-4xl text-base leading-8 text-brand-text sm:text-lg sm:leading-9">
        {company.about}
      </p>
      <div class="mt-8 grid items-start gap-4 md:grid-cols-2">
        <article class="card overflow-hidden p-3">
          <img
            src="/images/company/about-cover.jpg"
            alt="تصویر معرفی شرکت ایمن صنعت باتاب"
            width="1064"
            height="890"
            loading="lazy"
            decoding="async"
            class="h-full w-full rounded-xl object-cover"
          />
        </article>
        <div class="grid gap-4">
          <article class="card p-5">
            <p class="text-xs text-brand-muted">مدیرعامل</p>
            <h2 class="mt-1 text-lg font-bold text-brand-primary">
              {company.organizationalChart.ceo}
            </h2>
          </article>
          <article class="card p-5">
            <p class="text-xs text-brand-muted">نوع شرکت / تاریخ تاسیس</p>
            <p class="mt-1 text-sm font-semibold text-brand-primary">
              {company.legalType} • {company.foundedAt}
            </p>
            <p class="mt-2 text-xs text-brand-muted">ثبت رسمی در اداره ثبت شرکت‌ها و موسسات غیر تجاری تهران</p>
          </article>
        </div>
      </div>
    </div>
  </section>

  <section class="section-block bg-white">
    <div class="container-wrap grid gap-8 lg:grid-cols-2">
      <article class="card p-6">
        <h2 class="text-xl font-bold text-brand-primary">اهداف و ماموریت</h2>
        <ul class="mt-4 space-y-2 text-sm leading-7 text-brand-text">
          {company.mission.map((item) => <li>• {item}</li>)}
        </ul>
      </article>
      <article class="card p-6">
        <h2 class="text-xl font-bold text-brand-primary">چشم‌انداز و ارزش‌ها</h2>
        <p class="mt-4 text-sm leading-8 text-brand-text">{company.vision}</p>
        <ul class="mt-4 space-y-2 text-sm leading-7 text-brand-text">
          {company.values.map((item) => <li>• {item}</li>)}
        </ul>
      </article>
    </div>
  </section>

  <section class="section-block" id="policy">
    <div class="container-wrap">
      <article class="card p-6 sm:p-8">
        <h2 class="text-2xl font-bold text-brand-primary">خط مشی شرکت ایمن صنعت باتاب</h2>
        <p class="mt-4 text-sm leading-8 text-brand-text">{company.policy}</p>
        <ol class="mt-5 list-decimal space-y-3 pr-5 text-sm leading-8 text-brand-text">
          {company.policyItems.map((item) => <li>{item}</li>)}
        </ol>
      </article>
    </div>
  </section>

  <section class="section-block bg-white">
    <div class="container-wrap grid gap-8 lg:grid-cols-2">
      <article class="card p-6">
        <h2 class="text-xl font-bold text-brand-primary">مسئولیت اجتماعی</h2>
        <p class="mt-4 text-sm font-semibold text-brand-accent">محیط زیست</p>
        <p class="mt-2 text-sm leading-7 text-brand-muted">{company.hseApproach.environmentIntro}</p>
        <ul class="mt-2 space-y-2 text-sm leading-7 text-brand-text">
          {company.hseApproach.environment.map((item) => <li>• {item}</li>)}
        </ul>
        <p class="mt-5 text-sm font-semibold text-brand-accent">ایمنی کارکنان</p>
        <p class="mt-2 text-sm leading-7 text-brand-muted">{company.hseApproach.employeeSafetyIntro}</p>
        <ul class="mt-2 space-y-2 text-sm leading-7 text-brand-text">
          {company.hseApproach.employeeSafety.map((item) => <li>• {item}</li>)}
        </ul>
      </article>
      <div class="grid gap-4">
        <article class="card p-6">
          <h2 class="text-xl font-bold text-brand-primary">تاریخچه شرکت</h2>
          <ul class="mt-4 space-y-3">
            {
              company.history.map((item) => (
                <li class="rounded-lg border border-brand-border bg-slate-50 px-3 py-2">
                  <p class="text-sm font-semibold text-brand-accent">{toPersianDigits(item.year)}</p>
                  <p class="mt-1 text-sm leading-7 text-brand-text">{item.description}</p>
                </li>
              ))
            }
          </ul>
        </article>
        <article class="card p-6">
          <h2 class="text-xl font-bold text-brand-primary">مجوزها و گواهی‌نامه‌ها</h2>
          <p class="mt-3 text-sm leading-7 text-brand-muted">
            شرکت دارای مجوزها و گواهی‌نامه‌های رسمی فعالیت و سیستم مدیریتی معتبر است.
          </p>
          <div class="mt-4 flex flex-wrap gap-2">
            {company.standards.map((standard) => <Badge text={standard} tone="primary" />)}
          </div>
          <a
            href="/certifications"
            class="mt-4 inline-flex text-sm font-semibold text-brand-accent hover:text-brand-primary"
          >
            مشاهده گواهی‌نامه‌ها و مجوزها
          </a>
        </article>
      </div>
    </div>
  </section>

  <section class="section-block">
    <div class="container-wrap">
      <OrganizationChart company={company} />
    </div>
  </section>
</BaseLayout>
