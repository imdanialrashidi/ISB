---
import { getCollection, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { articleJsonLd, canonicalUrl, LOGO_URL } from "../../lib/seo";
import companyData from "../../content/company.json";
import type { CompanyContent } from "../../lib/types";

interface Props {
  post: CollectionEntry<"blog">;
}

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props as Props;
const { Content } = await post.render();
const company = companyData as CompanyContent;
const url = canonicalUrl(`/blog/${post.slug}`);
const articleLd = articleJsonLd({
  headline: post.data.title,
  url,
  datePublished: post.data.publishDate.toISOString().slice(0, 10),
  companyName: company.name,
  companyUrl: canonicalUrl("/"),
  companyLogo: canonicalUrl(LOGO_URL),
});
const breadcrumbs = [
  { name: "خانه", path: "/" },
  { name: "بلاگ", path: "/blog/" },
  { name: post.data.title },
];
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  canonicalPath={`/blog/${post.slug}/`}
  breadcrumbs={breadcrumbs}
>
  <Fragment slot="head">
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(articleLd).replace(/</g, "\\u003c")}
    />
  </Fragment>
  <article class="section-block">
    <div class="container-wrap">
      <div class="mx-auto max-w-3xl">
        <nav aria-label="مسیر صفحه" class="text-xs text-brand-muted">
          <ol class="flex flex-wrap items-center gap-1">
            {
              breadcrumbs.map((crumb, index) => (
                <li class="flex items-center gap-1">
                  {index > 0 && <span aria-hidden="true">/</span>}
                  {
                    crumb.path ? (
                      <a href={crumb.path} class="font-semibold text-brand-accent hover:text-brand-primary">
                        {crumb.name}
                      </a>
                    ) : (
                      <span aria-current="page" class="font-semibold text-brand-text">
                        {crumb.name}
                      </span>
                    )
                  }
                </li>
              ))
            }
          </ol>
        </nav>
        <h1 class="mt-4 text-3xl font-bold text-brand-primary">{post.data.title}</h1>
        <p class="mt-3 text-sm text-brand-muted">
          {new Intl.DateTimeFormat("fa-IR", { dateStyle: "long", timeZone: "Asia/Tehran" }).format(post.data.publishDate)}
        </p>
        <div
          class="prose prose-slate prose-headings:text-brand-primary prose-a:text-brand-accent mt-8 max-w-none leading-8"
        >
          <Content />
        </div>
        <p class="mt-8 text-sm">
          <a href="/blog/" class="font-semibold text-brand-accent hover:text-brand-primary">
            بازگشت به بلاگ
          </a>
        </p>
      </div>
    </div>
  </article>
</BaseLayout>
