---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionTitle from "../../components/SectionTitle.astro";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime(),
);
---

<BaseLayout
  title="بلاگ ایمن صنعت باتاب | مقالات ایمنی و HSE"
  description="مقالات تخصصی ایمنی صنعتی، HSE و مدیریت ریسک توسط ایمن صنعت باتاب."
  canonicalPath="/blog/"
  noIndex
>
  <section class="section-block">
    <div class="container-wrap">
      <SectionTitle
        title="بلاگ تخصصی ایمنی صنعتی"
        subtitle="در نسخه‌های بعدی، محتوای تخصصی برای صنایع نفت، گاز، پتروشیمی و معادن در این بخش منتشر می‌شود."
        level="h1"
      />
      <div class="grid gap-4">
        {
          posts.map((post) => (
            <article class="card p-6">
              <a
                href={`/blog/${post.slug}/`}
                class="text-lg font-bold text-brand-primary hover:text-brand-accent"
              >
                {post.data.title}
              </a>
              <p class="mt-2 text-sm leading-7 text-brand-muted">{post.data.description}</p>
              <p class="mt-3 text-xs text-brand-muted">
                {new Intl.DateTimeFormat("fa-IR", { dateStyle: "long", timeZone: "Asia/Tehran" }).format(
                  post.data.publishDate,
                )}
              </p>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
