---
import { Image } from "astro:assets";
import ContactCTA from "../../components/ContactCTA.astro";
import projectsData from "../../content/projects.json";
import certificationsData from "../../content/certifications.json";
import contactsData from "../../content/contacts.json";
import servicesData from "../../content/services.json";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { toPersianDigits } from "../../lib/locale";
import { resolveRaster } from "../../lib/media";
import { summarize } from "../../lib/seo";
import { waMeHref } from "../../lib/whatsapp";
import type {
  CertificatesContent,
  ContactsContent,
  ProjectItem,
  ServiceItem,
} from "../../lib/types";

interface Props {
  service: ServiceItem;
}

export function getStaticPaths() {
  const services = servicesData as ServiceItem[];
  return services
    .filter((service) => service.detailPage)
    .map((service) => ({ params: { id: service.id }, props: { service } }));
}

const { service } = Astro.props as Props;
const services = servicesData as ServiceItem[];
const projects = projectsData as ProjectItem[];
const certificates = certificationsData as CertificatesContent;
const contacts = contactsData as ContactsContent;

const relatedProjects = projects.filter((project) =>
  service.relatedProjectIds?.includes(project.id),
);
const qualificationCertificates = (service.qualificationCertificateIds ?? []).map((id) =>
  certificates.qualificationCertificates.find((item) => item.id === id),
);
const managementCertificates = (service.managementCertificateIds ?? []).map((id) =>
  certificates.managementCertificates.find((item) => item.id === id),
);
const documents = (service.documentIds ?? []).map((id) =>
  certificates.documents.find((item) => item.id === id),
);
const licenses = (service.licenseIds ?? []).map((id) =>
  certificates.licenses.find((item) => item.id === id),
);
const evidence = [
  ...qualificationCertificates,
  ...managementCertificates,
  ...documents,
  ...licenses,
].filter((item): item is NonNullable<typeof item> => Boolean(item));

const relatedServices = services.filter(
  (item) => item.detailPage && item.id !== service.id && item.category === service.category,
);
const raster = resolveRaster(service.image);
const mainPhone = contacts.phones[0];
const whatsappHref =
  contacts.whatsapp.status === "active" && contacts.whatsapp.number
    ? waMeHref(contacts.whatsapp.number)
    : "/contact/#whatsapp";
const description = summarize(service.detailIntro ?? service.summary);
const breadcrumbs = [
  { name: "خانه", path: "/" },
  { name: "خدمات", path: "/services/" },
  { name: service.title },
];
---

<BaseLayout
  title={service.title}
  description={description}
  canonicalPath={`/services/${service.id}/`}
  breadcrumbs={breadcrumbs}
>
  <section class="section-block">
    <div class="container-wrap">
      <nav aria-label="مسیر صفحه" class="text-xs text-brand-muted">
        <ol class="flex flex-wrap items-center gap-1">
          {
            breadcrumbs.map((crumb, index) => (
              <li class="flex items-center gap-1">
                {index > 0 && <span aria-hidden="true">/</span>}
                {
                  crumb.path ? (
                    <a href={crumb.path} class="font-semibold text-brand-accent hover:text-brand-primary">
                      {crumb.name}
                    </a>
                  ) : (
                    <span aria-current="page" class="font-semibold text-brand-text">
                      {crumb.name}
                    </span>
                  )
                }
              </li>
            ))
          }
        </ol>
      </nav>

      <div class="mt-6 grid items-start gap-6 lg:grid-cols-5">
        <div class="lg:col-span-3">
          <p class="text-xs font-semibold text-brand-accent">{service.category}</p>
          <h1 class="mt-2 text-2xl font-bold leading-10 text-brand-primary sm:text-3xl">
            {service.title}
          </h1>
          <p class="mt-4 text-sm leading-8 text-brand-text sm:text-base">
            {service.detailIntro}
          </p>
          {
            service.details.length > 0 && (
              <ul class="mt-5 space-y-2 text-sm leading-7 text-brand-text">
                {service.details.map((item) => <li>• {item}</li>)}
              </ul>
            )
          }
          {
            service.highlights.length > 0 && (
              <ul class="mt-5 flex flex-wrap gap-2">
                {service.highlights.map((item) => (
                  <li class="rounded-full border border-brand-accent/30 bg-brand-accent/5 px-3 py-1 text-xs font-semibold text-brand-accent">
                    {item}
                  </li>
                ))}
              </ul>
            )
          }
        </div>
        <div class="lg:col-span-2">
          {
            raster ? (
              <Image
                src={raster}
                widths={[480, 640, 960]}
                sizes="(min-width: 1024px) 400px, 100vw"
                width={640}
                height={360}
                format="webp"
                quality={82}
                fit="cover"
                loading="eager"
                decoding="async"
                alt={service.title}
                class="aspect-[16/9] w-full rounded-2xl border border-brand-border object-cover"
              />
            ) : (
              <img
                src={service.image}
                width="640"
                height="360"
                loading="eager"
                decoding="async"
                alt={service.title}
                class="aspect-[16/9] w-full rounded-2xl border border-brand-border object-cover"
              />
            )
          }
        </div>
      </div>
    </div>
  </section>

  {
    evidence.length > 0 && (
      <section class="section-block bg-white">
        <div class="container-wrap">
          <h2 class="text-xl font-bold text-brand-primary">مجوزها، گواهی‌نامه‌ها و صلاحیت‌های مرتبط</h2>
          <p class="mt-3 text-sm leading-7 text-brand-muted">
            مستندات رسمی مرتبط با این خدمت که در بخش گواهی‌نامه‌های شرکت قابل استعلام است:
          </p>
          <div class="mt-5 grid gap-4 md:grid-cols-2">
            {
              evidence.map((item) => (
                <article class="card p-5">
                  <h3 class="text-base font-bold text-brand-primary">{item.title}</h3>
                  <p class="mt-2 text-sm text-brand-text">{item.issuer}</p>
                  <p class="mt-1 text-xs text-brand-muted">
                    وضعیت / اعتبار: {item.validity}
                    {"description" in item && item.description && (
                      <span class="mt-1 block text-brand-muted">{item.description}</span>
                    )}
                  </p>
                </article>
              ))
            }
          </div>
          <a
            href="/certifications/"
            class="mt-5 inline-flex text-sm font-semibold text-brand-accent hover:text-brand-primary"
          >
            مشاهده همه گواهی‌نامه‌ها و مجوزها
          </a>
        </div>
      </section>
    )
  }

  {
    relatedProjects.length > 0 && (
      <section class="section-block">
        <div class="container-wrap">
          <h2 class="text-xl font-bold text-brand-primary">تجربه پروژه‌های مرتبط</h2>
          <p class="mt-3 text-sm leading-7 text-brand-muted">
            نمونه‌هایی از پروژه‌های اجراشده شرکت در این حوزه:
          </p>
          <div class="mt-5 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
            {
              relatedProjects.map((project, index) => (
                <article class="card p-5">
                  <p class="text-xs text-brand-muted">ردیف {toPersianDigits(index + 1)}</p>
                  <h3 class="mt-1 text-base font-bold text-brand-primary">{project.title}</h3>
                  <p class="mt-1 text-sm text-brand-muted">کارفرما: {project.client}</p>
                </article>
              ))
            }
          </div>
          <a
            href="/projects/"
            class="mt-5 inline-flex text-sm font-semibold text-brand-accent hover:text-brand-primary"
          >
            مشاهده رزومه کامل پروژه‌ها
          </a>
        </div>
      </section>
    )
  }

  {
    relatedServices.length > 0 && (
      <section class="section-block bg-white">
        <div class="container-wrap">
          <h2 class="text-xl font-bold text-brand-primary">خدمات مرتبط</h2>
          <div class="mt-5 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
            {
              relatedServices.map((item) => (
                <article class="card p-5">
                  <h3 class="text-base font-bold">
                    <a
                      href={`/services/${item.id}/`}
                      class="text-brand-primary transition hover:text-brand-accent focus-visible:text-brand-accent"
                    >
                      {item.title}
                    </a>
                  </h3>
                  <p class="mt-2 text-sm leading-7 text-brand-muted">{item.summary}</p>
                </article>
              ))
            }
          </div>
        </div>
      </section>
    )
  }

  <div class="container-wrap">
    <ContactCTA
      title={`استعلام ${service.title}`}
      description="برای دریافت جزئیات اجرا، تعرفه و هماهنگی بازدید با تیم پشتیبانی شرکت در ارتباط باشید."
      phoneHref={`tel:${mainPhone.tel}`}
      phoneLabel={`تماس با دفتر (${toPersianDigits(mainPhone.number)})`}
      whatsappHref={whatsappHref}
    />
  </div>
</BaseLayout>
