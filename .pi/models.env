# Project-local Pi launcher switchboard.
# The primary coding model stays on DeepSeek V4 Flash.
#
# WARNING: this file is COMMITTED to the public repository. It must never
# contain API keys, tokens, or any secret value. Machine-specific overrides
# belong in your shell environment or ~/.pi config, not here.
export PI_MAIN_MODEL="opencode-go/deepseek-v4-flash"
export PI_MAIN_THINKING="max"
export PI_ENABLED_MODELS=""

# Startup/network posture. Override in your shell when needed.
export PI_TELEMETRY="0"
export PI_SKIP_VERSION_CHECK="1"
export PI_CACHE_RETENTION="long"
